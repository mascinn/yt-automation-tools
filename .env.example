# Server Configuration
PORT=3000

# AI Service Configuration
# AI_PROVIDER: "openai" (OpenAI-compatible endpoints: OpenAI, OpenRouter, Groq, Ollama) or "mock" (offline testing)
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# Image Generation Configuration
# IMAGE_PROVIDER: "openai" (DALL-E 3) or "mock" (offline SVG generator)
IMAGE_PROVIDER=openai
IMAGE_API_KEY=
IMAGE_MODEL=dall-e-3
IMAGE_BASE_URL=https://api.openai.com/v1

# Voice / TTS Configuration
# TTS_PROVIDER: "openai" or "mock"
TTS_PROVIDER=openai
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_VOICE=onyx
TTS_BASE_URL=https://api.openai.com/v1

# Channel Safety
AUTO_PUBLISH=false

# YouTube Configuration
# YOUTUBE_PROVIDER: "google" (official YouTube Data API v3) or "mock" (offline simulation)
YOUTUBE_PROVIDER=mock
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_ACCESS_TOKEN=
DEFAULT_PRIVACY_STATUS=private

